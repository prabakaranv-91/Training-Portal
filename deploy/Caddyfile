{
    email {$ACME_EMAIL}
    admin off
}

{$APP_DOMAIN} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    request_body {
        max_size 1MB
    }
    @cross_origin {
        method POST PUT PATCH DELETE
        header Origin *
        not header Origin https://{$APP_DOMAIN}:{$HTTPS_PORT}
    }
    respond @cross_origin "Cross-origin request denied" 403
    reverse_proxy app:8000
}

http://{$APP_DOMAIN} {
    redir https://{$APP_DOMAIN}:{$HTTPS_PORT}{uri} permanent
}